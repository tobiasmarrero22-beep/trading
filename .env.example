# Copiá este archivo como .env y completá tus claves de Alpaca.
# NUNCA subas el archivo .env a GitHub (ya está en .gitignore).
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Solo para dinero real (mode: alpaca_live). Dejalo vacío mientras practicás.
BOT_LIVE_CONFIRM=

# --- Bot de trading diario (daytrade.py) ---
# Testnet: claves de https://testnet.binance.vision  |  Real: claves de binance.com
# En binance.com, al crear la clave activá SOLO "lectura" y "trading al contado". NUNCA "retiros".
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Solo para dinero real (mode: binance_live).
DAYTRADE_LIVE_CONFIRM=
